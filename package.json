{
  "name": "artinex-ai-publication",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Artinex: an editorial-first AI publication with attributed live RSS headlines",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "check": "npm test",
    "article:add": "node scripts/publish.mjs"
  }
}
